<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="23501" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="loan-controller">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies><plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23504"/><capability name="Safe area layout guides" minToolsVersion="9.0"/><capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/></dependencies>
    <scenes><scene sceneID="loan-scene"><objects>
        <viewController id="loan-controller" customClass="ViewController" customModule="Prestamos_UIKit" customModuleProvider="target" sceneMemberID="viewController">
            <view key="view" contentMode="scaleToFill" id="loan-view">
                <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                <viewLayoutGuide key="safeArea" id="loan-safe"/>
                <subviews>
                    <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" alignment="fill" spacing="16" translatesAutoresizingMaskIntoConstraints="NO" id="form-stack">
                        <rect key="frame" x="24" y="91" width="345" height="541"/>
                        <subviews>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Calculadora de préstamos" textAlignment="center" lineBreakMode="wordWrap" numberOfLines="0" translatesAutoresizingMaskIntoConstraints="NO" id="loan-title"><fontDescription key="fontDescription" type="boldSystem" pointSize="25"/><color key="textColor" systemColor="systemBlueColor"/></label>
                            <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" alignment="fill" spacing="6" translatesAutoresizingMaskIntoConstraints="NO" id="capital-row">
                                <subviews>
                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Capital inicial" translatesAutoresizingMaskIntoConstraints="NO" id="capital-label"><fontDescription key="fontDescription" type="system" pointSize="17"/></label>
                                    <textField opaque="NO" contentMode="scaleToFill" borderStyle="roundedRect" placeholder="Ej. 10000" textAlignment="left" translatesAutoresizingMaskIntoConstraints="NO" id="capital-field"><constraints><constraint firstAttribute="height" constant="44" id="capital-height"/></constraints><textInputTraits key="textInputTraits" keyboardType="decimalPad"/></textField>
                                </subviews>
                            </stackView>
                            <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" alignment="fill" spacing="6" translatesAutoresizingMaskIntoConstraints="NO" id="rate-row">
                                <subviews>
                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Tasa de interés anual (%)" translatesAutoresizingMaskIntoConstraints="NO" id="rate-label"><fontDescription key="fontDescription" type="system" pointSize="17"/></label>
                                    <textField opaque="NO" contentMode="scaleToFill" borderStyle="roundedRect" placeholder="Ej. 12" textAlignment="left" translatesAutoresizingMaskIntoConstraints="NO" id="rate-field"><constraints><constraint firstAttribute="height" constant="44" id="rate-height"/></constraints><textInputTraits key="textInputTraits" keyboardType="decimalPad"/></textField>
                                </subviews>
                            </stackView>
                            <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" alignment="fill" spacing="6" translatesAutoresizingMaskIntoConstraints="NO" id="years-row">
                                <subviews>
                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Plazo del préstamo (años)" translatesAutoresizingMaskIntoConstraints="NO" id="years-label"><fontDescription key="fontDescription" type="system" pointSize="17"/></label>
                                    <textField opaque="NO" contentMode="scaleToFill" borderStyle="roundedRect" placeholder="Ej. 1" textAlignment="left" translatesAutoresizingMaskIntoConstraints="NO" id="years-field"><constraints><constraint firstAttribute="height" constant="44" id="years-height"/></constraints><textInputTraits key="textInputTraits" keyboardType="numberPad"/></textField>
                                </subviews>
                            </stackView>
                            <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" translatesAutoresizingMaskIntoConstraints="NO" id="calculate-button"><constraints><constraint firstAttribute="height" constant="50" id="button-height"/></constraints><buttonConfiguration key="configuration" style="filled" title="Calcular préstamo"/><connections><action selector="calcularPrestamo:" destination="loan-controller" eventType="touchUpInside" id="calculate-action"/></connections></button>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Resultado" textAlignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="result-heading"><fontDescription key="fontDescription" type="boldSystem" pointSize="20"/></label>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Cuota mensual: —" textAlignment="center" lineBreakMode="wordWrap" numberOfLines="0" translatesAutoresizingMaskIntoConstraints="NO" id="monthly-label"><fontDescription key="fontDescription" type="system" pointSize="20"/></label>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Total a pagar: —" textAlignment="center" lineBreakMode="wordWrap" numberOfLines="0" translatesAutoresizingMaskIntoConstraints="NO" id="total-label"><fontDescription key="fontDescription" type="system" pointSize="20"/></label>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Los montos se expresan en la misma moneda del capital." textAlignment="center" lineBreakMode="wordWrap" numberOfLines="0" translatesAutoresizingMaskIntoConstraints="NO" id="currency-note"><fontDescription key="fontDescription" type="system" pointSize="13"/><color key="textColor" systemColor="secondaryLabelColor"/></label>
                        </subviews>
                    </stackView>
                </subviews>
                <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                <constraints>
                    <constraint firstItem="form-stack" firstAttribute="top" secondItem="loan-safe" secondAttribute="top" constant="32" id="form-top"/>
                    <constraint firstItem="form-stack" firstAttribute="leading" secondItem="loan-safe" secondAttribute="leading" constant="24" id="form-leading"/>
                    <constraint firstItem="loan-safe" firstAttribute="trailing" secondItem="form-stack" secondAttribute="trailing" constant="24" id="form-trailing"/>
                    <constraint firstItem="loan-safe" firstAttribute="bottom" relation="greaterThanOrEqual" secondItem="form-stack" secondAttribute="bottom" constant="16" id="form-bottom"/>
                </constraints>
            </view>
            <connections>
                <outlet property="capitalTextField" destination="capital-field" id="capital-outlet"/>
                <outlet property="annualRateTextField" destination="rate-field" id="rate-outlet"/>
                <outlet property="yearsTextField" destination="years-field" id="years-outlet"/>
                <outlet property="monthlyPaymentLabel" destination="monthly-label" id="monthly-outlet"/>
                <outlet property="totalPaymentLabel" destination="total-label" id="total-outlet"/>
            </connections>
        </viewController>
        <placeholder placeholderIdentifier="IBFirstResponder" id="loan-responder" userLabel="First Responder" sceneMemberID="firstResponder"/>
    </objects></scene></scenes>
    <resources>
        <systemColor name="secondaryLabelColor"><color red="0.23529411764705882" green="0.23529411764705882" blue="0.2627450980392157" alpha="0.6" colorSpace="custom" customColorSpace="sRGB"/></systemColor>
        <systemColor name="systemBackgroundColor"><color white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/></systemColor>
        <systemColor name="systemBlueColor"><color red="0" green="0.47843137254901963" blue="1" alpha="1" colorSpace="custom" customColorSpace="sRGB"/></systemColor>
    </resources>
</document>
