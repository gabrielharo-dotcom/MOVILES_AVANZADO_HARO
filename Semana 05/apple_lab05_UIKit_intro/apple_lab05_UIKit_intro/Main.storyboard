<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="23501" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="intro-controller">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies><plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23504"/><capability name="Safe area layout guides" minToolsVersion="9.0"/><capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/></dependencies>
    <scenes><scene sceneID="intro-scene"><objects>
        <viewController id="intro-controller" customClass="ViewController" customModule="apple_lab05_UIKit_intro" customModuleProvider="target" sceneMemberID="viewController">
            <view key="view" contentMode="scaleToFill" id="intro-view">
                <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                <viewLayoutGuide key="safeArea" id="safe-area"/>
                <subviews>
                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Diseño y Desarrollo de Software" textAlignment="center" lineBreakMode="wordWrap" numberOfLines="0" translatesAutoresizingMaskIntoConstraints="NO" id="title-label">
                        <rect key="frame" x="24" y="395" width="345" height="62"/>
                        <fontDescription key="fontDescription" type="system" pointSize="24"/>
                        <color key="textColor" systemColor="systemBlueColor"/>
                    </label>
                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Gabriel Haro" textAlignment="center" lineBreakMode="tailTruncation" numberOfLines="1" translatesAutoresizingMaskIntoConstraints="NO" id="name-label">
                        <rect key="frame" x="81" y="482" width="231" height="42"/>
                        <fontDescription key="fontDescription" type="system" pointSize="17"/>
                        <color key="textColor" systemColor="labelColor"/>
                        <constraints><constraint firstAttribute="width" constant="231" id="name-width"/></constraints>
                    </label>
                </subviews>
                <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                <constraints>
                    <constraint firstItem="title-label" firstAttribute="centerX" secondItem="safe-area" secondAttribute="centerX" id="title-center-x"/>
                    <constraint firstItem="title-label" firstAttribute="centerY" secondItem="safe-area" secondAttribute="centerY" constant="-60" id="title-center-y"/>
                    <constraint firstItem="safe-area" firstAttribute="trailing" relation="greaterThanOrEqual" secondItem="title-label" secondAttribute="trailing" constant="24" id="title-trailing"/>
                    <constraint firstItem="title-label" firstAttribute="leading" relation="greaterThanOrEqual" secondItem="safe-area" secondAttribute="leading" constant="24" id="title-leading"/>
                    <constraint firstItem="name-label" firstAttribute="top" secondItem="title-label" secondAttribute="bottom" constant="64" id="vertical-spacing"/>
                    <constraint firstItem="name-label" firstAttribute="centerX" secondItem="safe-area" secondAttribute="centerX" id="name-center-x"/>
                </constraints>
            </view>
        </viewController>
        <placeholder placeholderIdentifier="IBFirstResponder" id="intro-responder" userLabel="First Responder" sceneMemberID="firstResponder"/>
    </objects></scene></scenes>
    <resources>
        <systemColor name="systemBackgroundColor"><color white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/></systemColor>
        <systemColor name="systemBlueColor"><color red="0" green="0.47843137254901963" blue="1" alpha="1" colorSpace="custom" customColorSpace="sRGB"/></systemColor>
        <systemColor name="labelColor"><color white="0" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/></systemColor>
    </resources>
</document>
